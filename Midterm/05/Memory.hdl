CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];
    PARTS:
    DMux4Way(in=load, sel=address[13..14], a=lram1, b=lram2, c=lscr, d=lkbd);
    Or(a=lram1, b=lram2, out=lram);
    RAM16K(in=in, load=lram, address=address[0..13], out=ramout);
    Screen(in=in, load=lscr, address=address[0..12], out=scrout);
    Keyboard(out=kbdout);
    Mux4Way16(a=ramout, b=ramout, c=scrout, d=kbdout, sel=address[13..14], out=out);
}