CHIP ALU {
    IN  
        x[16], y[16],  
        zx, nx, zy, ny, f, no; 

    OUT 
        out[16], zr, ng;

    PARTS:
    // Process x
    Mux16(a=x, b=false, sel=zx, out=x1);
    Not16(in=x1, out=notx1);
    Mux16(a=x1, b=notx1, sel=nx, out=x2);

    // Process y
    Mux16(a=y, b=false, sel=zy, out=y1);
    Not16(in=y1, out=noty1);
    Mux16(a=y1, b=noty1, sel=ny, out=y2);

    // Compute f
    Add16(a=x2, b=y2, out=addOut);
    And16(a=x2, b=y2, out=andOut);
    Mux16(a=andOut, b=addOut, sel=f, out=fOut);

    // Output negation & flags
    Not16(in=fOut, out=notFOut);
    Mux16(a=fOut, b=notFOut, sel=no, out=out, out[0..7]=lowByte, out[8..15]=highByte, out[15]=ng);

    // Compute zr
    Or8Way(in=lowByte, out=orLow);
    Or8Way(in=highByte, out=orHigh);
    Or(a=orLow, b=orHigh, out=nonzero);
    Not(in=nonzero, out=zr);
}